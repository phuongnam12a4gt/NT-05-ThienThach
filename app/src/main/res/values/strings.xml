  <string name="help_controls" formatted="false">01 / CONTROLS</string>
  <string name="help_controls_body" formatted="false">Drag sideways in the play area. The ship follows drag distance, without jumping to your touch. Dodge falling meteors; movement is horizontal only.</string>
  <string name="help_survive" formatted="false">02 / SURVIVAL</string>
  <string name="help_survive_body" formatted="false">Hits cost 1 armor. At zero, the flight ends. After a hit, the ship flashes and is invulnerable for 1.2 seconds. Difficulty rises every 20 seconds.</string>
  <string name="help_items" formatted="false">03 / SUPPLIES</string>
  <string name="help_shield" formatted="false">◇ Shield: blocks one hit; lasts 8 seconds.</string>
  <string name="help_repair" formatted="false">+ Repair: restores 1 armor, up to your maximum.</string>
  <string name="help_slow" formatted="false">◷ Slow: meteors move at 60% speed for 5 seconds.</string>
  <string name="help_rewards" formatted="false">04 / FLIGHT REWARDS</string>
  <string name="help_rewards_body" formatted="false">Survival: 10 points/second. Items: 25 points each. Every 20 final points earn 1 credit for ship upgrades. Abandoned flights earn nothing.</string>
  <string name="help_accessibility" formatted="false">Play requires real-time observation and dragging.</string>
