  <string name="help_controls" formatted="false">01 / CONTROLES</string>
  <string name="help_controls_body" formatted="false">Arraste para os lados na área de jogo. A nave segue a distância arrastada, sem saltar até o toque. Desvie dos meteoros; o movimento é apenas horizontal.</string>
  <string name="help_survive" formatted="false">02 / SOBREVIVÊNCIA</string>
  <string name="help_survive_body" formatted="false">Cada impacto custa 1 de blindagem. Ao chegar a zero o voo acaba. Após um impacto, a nave pisca e fica invulnerável por 1,2 segundo. A dificuldade aumenta a cada 20 segundos.</string>
  <string name="help_items" formatted="false">03 / SUPRIMENTOS</string>
  <string name="help_shield" formatted="false">◇ Escudo: bloqueia um impacto; dura 8 segundos.</string>
  <string name="help_repair" formatted="false">+ Reparo: restaura 1 de blindagem, até o máximo.</string>
  <string name="help_slow" formatted="false">◷ Lentidão: meteoros a 60% da velocidade por 5 segundos.</string>
  <string name="help_rewards" formatted="false">04 / RECOMPENSAS DE VOO</string>
  <string name="help_rewards_body" formatted="false">Sobrevivência: 10 pontos/segundo. Itens: 25 pontos cada. Cada 20 pontos finais rendem 1 crédito para melhorias. Abandonar não rende recompensas.</string>
  <string name="help_accessibility" formatted="false">Exige observação e arraste em tempo real.</string>
