  <string name="help_controls" formatted="false">01 / नियंत्रण</string>
  <string name="help_controls_body" formatted="false">खेल क्षेत्र में बगल में खींचें। यान खींची दूरी के साथ चलता है, छूने की जगह पर नहीं कूदता। गिरती उल्काओं से बचें; गति केवल आड़ी है।</string>
  <string name="help_survive" formatted="false">02 / जीवन रक्षा</string>
  <string name="help_survive_body" formatted="false">टक्कर से 1 कवच घटता है। शून्य पर उड़ान समाप्त। चोट के बाद यान चमकता है और 1.2 सेकंड सुरक्षित रहता है। हर 20 सेकंड कठिनाई बढ़ती है।</string>
  <string name="help_items" formatted="false">03 / आपूर्ति</string>
  <string name="help_shield" formatted="false">◇ ढाल: एक टक्कर रोकती है; 8 सेकंड रहती है।</string>
  <string name="help_repair" formatted="false">+ मरम्मत: अधिकतम सीमा तक 1 कवच लौटाती है।</string>
  <string name="help_slow" formatted="false">◷ धीमापन: उल्काएँ 5 सेकंड तक 60% गति से चलती हैं।</string>
  <string name="help_rewards" formatted="false">04 / उड़ान के इनाम</string>
  <string name="help_rewards_body" formatted="false">जीवित रहना: 10 अंक/सेकंड। आइटम: हर एक के 25 अंक। अंतिम हर 20 अंक पर अपग्रेड के लिए 1 क्रेडिट। उड़ान छोड़ने पर कुछ नहीं मिलता।</string>
  <string name="help_accessibility" formatted="false">खेल के दौरान तुरंत देखना और खींचना ज़रूरी है।</string>
