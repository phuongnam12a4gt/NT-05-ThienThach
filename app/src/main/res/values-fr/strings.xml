  <string name="help_controls" formatted="false">01 / COMMANDES</string>
  <string name="help_controls_body" formatted="false">Glissez horizontalement dans la zone de jeu. Le vaisseau suit la distance glissée sans sauter au point touché. Évitez les météores ; déplacement horizontal uniquement.</string>
  <string name="help_survive" formatted="false">02 / SURVIE</string>
  <string name="help_survive_body" formatted="false">Chaque impact coûte 1 blindage. À zéro, le vol se termine. Après un impact, le vaisseau clignote et devient invulnérable 1,2 seconde. La difficulté monte toutes les 20 secondes.</string>
  <string name="help_items" formatted="false">03 / RAVITAILLEMENT</string>
  <string name="help_shield" formatted="false">◇ Bouclier : bloque un impact ; dure 8 secondes.</string>
  <string name="help_repair" formatted="false">+ Réparation : restaure 1 blindage, sans dépasser le maximum.</string>
  <string name="help_slow" formatted="false">◷ Ralenti : météores à 60% de vitesse pendant 5 secondes.</string>
  <string name="help_rewards" formatted="false">04 / RÉCOMPENSES DE VOL</string>
  <string name="help_rewards_body" formatted="false">Survie : 10 points/seconde. Objets : 25 points chacun. Chaque tranche de 20 points finaux donne 1 crédit pour les améliorations. Abandonner ne rapporte rien.</string>
  <string name="help_accessibility" formatted="false">Nécessite observation et glissement en temps réel.</string>
