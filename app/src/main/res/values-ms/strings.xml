  <string name="tip_energy" formatted="false">Anda tamat dengan denyut sedia. Gunakannya sebelum terperangkap pada penerbangan seterusnya.</string>
  <string name="tip_survive" formatted="false">Bertahan 30 saat untuk 100 mata bonus. Cari ruang dan jaga jarak.</string>
  <string name="tip_near" formatted="false">Cuba 5 elakan rapat untuk 150 mata bonus. Ambil risiko hanya dengan jalan keluar.</string>
  <string name="tip_combo" formatted="false">Sambung 6 elakan rapat dalam tempoh kombo untuk bonus ×3.</string>
